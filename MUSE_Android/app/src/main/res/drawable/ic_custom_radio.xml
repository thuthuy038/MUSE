<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State Selected (Checked): Pink circle border, Black tick, Larger -->
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2.5dp" android:color="#FB6F92" />
                    <solid android:color="@android:color/transparent" />
                    <size android:width="32dp" android:height="32dp" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
                    <path android:fillColor="#000000" android:pathData="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41z"/>
                </vector>
            </item>
        </layer-list>
    </item>

    <!-- State Unselected: Black circle border, Smaller -->
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="oval">
                <stroke android:width="2dp" android:color="#333333" />
                <solid android:color="@android:color/transparent" />
                <size android:width="24dp" android:height="24dp" />
            </shape>
        </inset>
    </item>
</selector>