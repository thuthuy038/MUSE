<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="60dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#FB6F92"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Bộ lọc"
        android:textColor="#FB6F92"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="80dp"
        android:layout_height="1dp"
        android:layout_gravity="center_horizontal"
        android:background="#FB6F92"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"/>

    <!-- Danh mục Section -->
    <LinearLayout
        android:id="@+id/sectionCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/headerCategory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh mục"
                android:textColor="#333333"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/iconCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#333333"
                android:textSize="24sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_filter_item_box"
            android:visibility="gone">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:paddingHorizontal="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Tất cả"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#FB6F92"
                    android:contentDescription="selected" />
            </RelativeLayout>
            <TextView android:layout_width="match_parent" android:layout_height="40dp" android:text="Đầm" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:textColor="#999999"/>
            <TextView android:layout_width="match_parent" android:layout_height="40dp" android:text="Áo" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:textColor="#999999"/>
            <TextView android:layout_width="match_parent" android:layout_height="40dp" android:text="Chân váy" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:textColor="#999999"/>
            <TextView android:layout_width="match_parent" android:layout_height="40dp" android:text="Quần" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:textColor="#999999"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Kích cỡ Section -->
    <LinearLayout
        android:id="@+id/sectionSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/headerSize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kích cỡ"
                android:textColor="#333333"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/iconSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#333333"
                android:textSize="24sp" />
        </LinearLayout>
        <GridLayout
            android:id="@+id/contentSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="8dp"
            android:visibility="gone">
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:buttonTint="#FB6F92" android:layout_marginEnd="32dp" android:checked="true"/>
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:buttonTint="#FB6F92"/>
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:buttonTint="#FB6F92"/>
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XL" android:buttonTint="#FB6F92"/>
        </GridLayout>
    </LinearLayout>

    <!-- Màu sắc Section -->
    <LinearLayout
        android:id="@+id/sectionColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/headerColor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Màu sắc"
                android:textColor="#333333"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/iconColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#333333"
                android:textSize="24sp" />
        </LinearLayout>
        <GridLayout
            android:id="@+id/contentColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:layout_marginEnd="24dp">
                <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#FB6F92" />
                <View android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/bg_filter_item_box" android:layout_marginHorizontal="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trắng" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#FB6F92" />
                <View android:layout_width="20dp" android:layout_height="20dp" android:background="#FF0000" android:layout_marginHorizontal="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đỏ" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#FB6F92" />
                <View android:layout_width="20dp" android:layout_height="20dp" android:background="#000000" android:layout_marginHorizontal="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đen" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#FB6F92" />
                <View android:layout_width="20dp" android:layout_height="20dp" android:background="#FB6F92" android:layout_marginHorizontal="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hồng" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>

    <!-- Giá Section -->
    <LinearLayout
        android:id="@+id/sectionPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/headerPrice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Giá"
                android:textColor="#333333"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/iconPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#333333"
                android:textSize="24sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="Tối thiểu"
                    android:background="@drawable/bg_filter_item_box"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    android:inputType="number"
                    android:importantForAutofill="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="đến" android:layout_marginHorizontal="8dp"/>
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="Tối đa"
                    android:background="@drawable/bg_filter_item_box"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    android:inputType="number"
                    android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 - 500.000" android:background="@drawable/bg_price_chip" android:padding="8dp" android:textSize="10sp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500.000 - 700.000" android:background="@drawable/bg_price_chip" android:padding="8dp" android:textSize="10sp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="trên 1.000.000" android:background="@drawable/bg_price_chip" android:padding="8dp" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Sao đánh giá Section -->
    <LinearLayout
        android:id="@+id/sectionStar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/headerStar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sao đánh giá"
                android:textColor="#333333"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/iconStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#333333"
                android:textSize="24sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentStar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 - 2 ⭐" android:buttonTint="#FB6F92" android:checked="true"/>
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 - 3 ⭐" android:buttonTint="#FB6F92" />
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 - 4 ⭐" android:buttonTint="#FB6F92" />
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 - 5 ⭐" android:buttonTint="#FB6F92" />
            <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 ⭐" android:buttonTint="#FB6F92" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFE5EC"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtCountFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="20 (các) sản phẩm"
            android:textColor="#333333"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="160dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#FB6F92"
            android:text="Áp dụng"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="27dp" />
    </RelativeLayout>

</LinearLayout>