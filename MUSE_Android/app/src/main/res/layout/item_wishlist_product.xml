<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/productCard"
        layout="@layout/item_product_vertical" />

    <!-- Chân thẻ: Nút bấm và Checkbox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

        <!-- Normal Mode Buttons -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFindSimilar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_button"
                android:gravity="center"
                android:padding="6dp"
                android:text="Tìm sản phẩm tương tự"
                android:textColor="@color/primary_500"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/btnAddToCart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_button"
                android:padding="8dp"
                android:src="@drawable/ic_shopping_bag"
                app:tint="@color/primary_500" />
        </LinearLayout>

        <!-- Edit Mode Checkbox -->
        <CheckBox
            android:id="@+id/cbSelectEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/primary_500"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
