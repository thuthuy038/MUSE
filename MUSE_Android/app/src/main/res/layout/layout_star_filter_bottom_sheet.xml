<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#DDDDDD" />

    <RadioGroup
        android:id="@+id/rgStarFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 5 Stars -->
        <RelativeLayout
            android:id="@+id/layoutStar5"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />

                <TextView
                    android:id="@+id/txtCount5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/montserrat"
                    android:text="120"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbStar5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/primary_500" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

        <!-- 4 Stars -->
        <RelativeLayout
            android:id="@+id/layoutStar4"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />

                <TextView
                    android:id="@+id/txtCount4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/montserrat"
                    android:text="120"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbStar4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/primary_500" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

        <!-- 3 Stars -->
        <RelativeLayout
            android:id="@+id/layoutStar3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />

                <TextView
                    android:id="@+id/txtCount3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/montserrat"
                    android:text="120"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbStar3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/primary_500" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

        <!-- 2 Stars -->
        <RelativeLayout
            android:id="@+id/layoutStar2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />

                <TextView
                    android:id="@+id/txtCount2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/montserrat"
                    android:text="120"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbStar2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/primary_500" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

        <!-- 1 Star -->
        <RelativeLayout
            android:id="@+id/layoutStar1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/star" app:tint="#FFD93D" />

                <TextView
                    android:id="@+id/txtCount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/montserrat"
                    android:text="120"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbStar1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/primary_500" />
        </RelativeLayout>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetStar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:text="Bỏ lọc"
            android:textColor="@color/primary_500"
            app:cornerRadius="4dp"
            app:strokeColor="@color/primary_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyStar"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary_500"
            android:fontFamily="@font/montserrat_bold"
            android:text="Đồng ý"
            android:textColor="@android:color/white"
            app:cornerRadius="4dp" />
    </LinearLayout>

</LinearLayout>
