<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/layoutAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_vector" />

            <TextView
                android:id="@+id/txtUserInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_placeholder"
                android:gravity="center"
                android:textColor="@color/primary_500"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="w*****_"
            android:textColor="#333333"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat"
            app:layout_constraintBottom_toBottomOf="@id/layoutAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnMenu"
            app:layout_constraintStart_toEndOf="@id/layoutAvatar"
            app:layout_constraintTop_toTopOf="@id/layoutAvatar" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_more_horiz"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#999999" />

        <LinearLayout
            android:id="@+id/layoutStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/txtUserName"
            app:layout_constraintTop_toBottomOf="@id/txtUserName">

            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star" app:tint="#FFD93D" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star" app:tint="#FFD93D" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star" app:tint="#FFD93D" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star" app:tint="#FFD93D" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star" app:tint="#FFD93D" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVariantInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PHÂN LOẠI: SIZE M, MÀU HỒNG"
            android:textColor="#999999"
            android:textSize="11sp"
            android:fontFamily="@font/montserrat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutStars" />

        <TextView
            android:id="@+id/txtComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat"
            android:lineSpacingExtra="4dp"
            android:text="Sản phẩm rất đẹp, vải mát, form chuẩn như ảnh..."
            android:textColor="#333333"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/txtVariantInfo" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReviewImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/txtComment" />

        <TextView
            android:id="@+id/txtReviewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat"
            android:text="19:16, 15/10/2025"
            android:textColor="#999999"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvReviewImages" />

        <!-- Seller Reply Section -->
        <LinearLayout
            android:id="@+id/layoutAdminReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F8F8F8"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/txtReviewDate">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="Phản hồi của người bán"
                android:textColor="#333333"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtAdminReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat"
                android:lineSpacingExtra="2dp"
                android:text="Cảm ơn bạn đã tin tưởng và ủng hộ MUSE..."
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/reviewDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE"
            app:layout_constraintTop_toBottomOf="@id/layoutAdminReply" />

        <LinearLayout
            android:id="@+id/btnHelpful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_helpful_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/txtReviewDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtReviewDate">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_thumb_up"
                app:tint="#666666" />

            <TextView
                android:id="@+id/txtHelpful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/montserrat"
                android:text="Hữu ích (56)"
                android:textColor="#333333"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
