<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp">

    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ================= CONTENT FOREGROUND ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMainContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <!-- Checkbox -->
                <CheckBox
                    android:id="@+id/cbSelect"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:buttonTint="@color/primary_500"
                    android:visibility="gone"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:layout_marginStart="-4dp"
                    app:layout_constraintBottom_toBottomOf="@id/imgProduct"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/imgProduct" />

                <!-- Ảnh sản phẩm -->
                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="0dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/demo_product"
                    app:layout_constraintStart_toEndOf="@id/cbSelect"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Tên sản phẩm -->
                <TextView
                    android:id="@+id/txtProductName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/montserrat"
                    android:maxLines="2"
                    android:text="Tên sản phẩm"
                    android:textColor="@color/neutral_900"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgProduct"
                    app:layout_constraintTop_toTopOf="@id/imgProduct" />

                <!-- Compatibility IDs for ProductAdapter -->
                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- ================= CART MODE UI ================= -->
                <LinearLayout
                    android:id="@+id/layoutVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#F2F2F2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@id/layoutQuantityEditor"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@id/txtProductName"
                    app:layout_constraintTop_toBottomOf="@id/txtProductName">

                    <TextView
                        android:id="@+id/txtProductSizes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat"
                        android:maxLines="1"
                        android:text="Màu | Size"
                        android:textColor="@color/neutral_600"
                        android:textSize="11sp" />

                    <!-- Compatibility IDs for ProductAdapter -->
                    <TextView android:id="@+id/txtVariant" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/neutral_600" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutQuantityEditor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="@id/layoutVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/layoutVariant">

                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/txtQuantity"
                        android:layout_width="30dp"
                        android:layout_height="22dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="#EFEFEF"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/btnAdd"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/montserrat"
                    android:text="790.000đ"
                    android:textColor="@color/primary_500"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/txtProductName"
                    app:layout_constraintTop_toBottomOf="@id/layoutVariant" />

                <!-- Compatibility IDs for ProductAdapter -->
                <TextView android:id="@+id/txtCartPrice" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />

                <!-- ================= READ ONLY UI ================= -->
                <LinearLayout
                    android:id="@+id/layoutReadOnly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/txtProductName"
                    app:layout_constraintTop_toBottomOf="@id/txtProductName">

                    <TextView
                        android:id="@+id/txtVariantReadOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hồng, S"
                        android:textColor="@color/neutral_600"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDiscountPriceReadOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="690.000đ"
                            android:textColor="@color/primary_500"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/layoutOriginalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/txtOriginalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="790.000đ"
                                android:textColor="@color/neutral_400"
                                android:textSize="11sp" />
                        </FrameLayout>

                        <!-- Compatibility IDs for ProductAdapter -->
                        <TextView android:id="@+id/txtOriginalPriceReadOnly" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />



                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/txtReadonlyQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x1"
                            android:textColor="@color/neutral_600"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- More Compatibility IDs for ProductAdapter -->
            <TextView android:id="@+id/txtOffer" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txtRating" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txtSoldCount" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txtSoldOut" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/layoutColors" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal" />
            <ImageView android:id="@+id/btnFavorite" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- ================= ACTIONS BACKEND (REVEALED ON SWIPE) ================= -->
            <LinearLayout
                android:id="@+id/layoutActions"
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutSimilar"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:background="@color/primary_500"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Sản phẩm\ntương tự"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutDelete"
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:background="#F44336"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xóa"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</com.google.android.material.card.MaterialCardView>
