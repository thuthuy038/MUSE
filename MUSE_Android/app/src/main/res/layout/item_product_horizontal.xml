<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <!-- ================= ACTIONS PHÍA SAU ================= -->

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layoutSimilar"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:background="#FB6F92"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sản phẩm"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tương tự"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDelete"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="#F44336"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= CARD FOREGROUND ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Checkbox chỉ dùng cho CART -->

            <CheckBox
                android:id="@+id/cbSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imgProduct"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgProduct" />

            <!-- Ảnh sản phẩm -->

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/demo_product"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@id/cbSelect"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.28" />

            <!-- Tên sản phẩm -->

            <TextView
                android:id="@+id/txtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tên sản phẩm"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgProduct"
                app:layout_constraintTop_toTopOf="@id/imgProduct" />

            <!-- ===================================================== -->
            <!-- ===================== CART MODE ===================== -->
            <!-- ===================================================== -->

            <LinearLayout
                android:id="@+id/layoutVariant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F2F2F2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                app:layout_constraintStart_toStartOf="@id/txtName"
                app:layout_constraintTop_toBottomOf="@id/txtName">

                <TextView
                    android:id="@+id/txtVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đỏ | M"
                    android:textColor="#666666"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/imgArrow"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_arrow_down" />

            </LinearLayout>

            <!-- Tăng giảm số lượng -->

            <LinearLayout
                android:id="@+id/layoutQuantityEditor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/layoutVariant">

                <ImageView
                    android:id="@+id/btnMinus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_remove" />

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#EFEFEF"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/btnAdd"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_add" />

            </LinearLayout>

            <!-- Giá CART -->

            <TextView
                android:id="@+id/txtCartPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="790.000đ"
                android:textColor="#FB6F92"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/layoutVariant"
                app:layout_constraintTop_toBottomOf="@id/layoutVariant" />

            <!-- ===================================================== -->
            <!-- ==================== READ ONLY ====================== -->
            <!-- ===================================================== -->

            <LinearLayout
                android:id="@+id/layoutReadOnly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/txtName"
                app:layout_constraintTop_toBottomOf="@id/txtName">

                <TextView
                    android:id="@+id/txtVariantReadOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hồng, S"
                    android:textColor="#8F8F8F"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtOriginalPriceReadOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="790.000đ"
                        android:textColor="#6B6464"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtDiscountPriceReadOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="690.000đ"
                        android:textColor="#FB6F92"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtReadonlyQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="x1"
                        android:textColor="#8F8F8F"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>