<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProduct"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/image" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layoutColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardProduct"
        app:layout_constraintStart_toStartOf="parent">
        <!-- Color dots will be added programmatically or using a small list -->
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/circle_indicator_active" android:backgroundTint="#FF6B6B" android:layout_marginEnd="4dp"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/circle_indicator_active" android:backgroundTint="#FFD93D" android:layout_marginEnd="4dp"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/circle_indicator_active" android:backgroundTint="#4D96FF" android:layout_marginEnd="4dp"/>
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@android:drawable/ic_media_next" app:tint="#CCCCCC"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnFavorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/favorite"
        app:tint="#333333"
        app:layout_constraintTop_toBottomOf="@id/cardProduct"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Áo baby doll tay bổng"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/layoutColors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtProductSizes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S-XL"
        android:textColor="#999999"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtProductName"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="650000 VNĐ"
        android:textColor="@color/primary_500"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtProductSizes"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtOriginalPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="850000 VNĐ"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtPrice"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        app:layout_constraintTop_toTopOf="@id/txtOriginalPrice"
        app:layout_constraintBottom_toBottomOf="@id/txtOriginalPrice"
        app:layout_constraintStart_toStartOf="@id/txtOriginalPrice"
        app:layout_constraintEnd_toEndOf="@id/txtOriginalPrice" />

    <TextView
        android:id="@+id/txtOffer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ưu đãi có hạn từ 15/6/2026 đến 20/6/2026"
        android:textColor="#999999"
        android:textSize="10sp"
        android:fontStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/txtOriginalPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/txtOffer"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.9"
            android:textColor="@color/primary_500"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/star"
            app:tint="#FFD93D" />

        <TextView
            android:id="@+id/txtSoldCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="(200 lượt mua)"
            android:textColor="#FB6F92"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
