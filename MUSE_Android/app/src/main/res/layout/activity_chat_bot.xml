<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Custom Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/neutral_900" />

        <ImageView
            android:id="@+id/logoMuse"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutTabs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/btnAiAgent"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_airobot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_500" />

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/layoutTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <TextView
                android:id="@+id/tabStylist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:text="NHÀ TẠO MẪU AI"
                android:textColor="@color/primary_500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabSuggestions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:text="GỢI Ý HÔM NAY"
                android:textColor="@color/neutral_600"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/primary_500"
            android:layout_marginBottom="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/layoutInputArea"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Bottom Input Area -->
    <LinearLayout
        android:id="@+id/layoutInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView">

        <!-- Suggestion Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChipColor"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="Xem màu khác 🎨"
                    android:textColor="@color/neutral_800"
                    android:textSize="11sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/primary_500" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChipAccessory"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="Thêm phụ kiện ✨"
                    android:textColor="@color/neutral_800"
                    android:textSize="11sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/primary_500" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChipStyle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Phong cách khác"
                    android:textColor="@color/neutral_800"
                    android:textSize="11sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/primary_500" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_pink"
            android:backgroundTint="#FFF0F3"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_info"
                app:tint="@color/neutral_500" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Hỏi Muse bất kì thứ gì nè..."
                android:textSize="14sp"
                android:fontFamily="@font/montserrat"
                android:inputType="textShortMessage" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/primary_500"
                app:fabCustomSize="40dp"
                app:srcCompat="@drawable/ic_send"
                app:tint="@color/white"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Suggestions Tab Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutSuggestionsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Today's Quote / Style Insight Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFF0F3">

                    <TextView
                        android:id="@+id/tvStyleTodayHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STYLE CỦA BẠN HÔM NAY ✨"
                        android:textColor="@color/primary_500"
                        android:textSize="11sp"
                        android:fontFamily="@font/montserrat_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Dựa trên hình thể và gu thời trang thanh lịch đã thiết lập, MUSE gợi ý các thiết kế nhẹ nhàng, bay bổng giúp tôn dáng mảnh mai và tôn vinh phong thái cuốn hút của riêng bạn."
                        android:textColor="@color/neutral_800"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Grid Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Sản phẩm gợi ý riêng cho bạn:"
                android:textColor="@color/neutral_900"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_bold" />

            <!-- Suggestions Product Recycler Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestionsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ViewPager for Tab Contents -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
